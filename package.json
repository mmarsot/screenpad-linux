{
  "name": "screenpad-linux-dev",
  "private": true,
  "description": "Development tooling only (format and lint for the GNOME Shell extension); nothing here is installed.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write 'gnome-shell/**/*.js' eslint.config.js",
